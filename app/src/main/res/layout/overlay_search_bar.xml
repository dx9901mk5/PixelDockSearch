<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- 2-row compact calibration HUD: always cleanly inset inside narrow phone / cover screens -->
    <LinearLayout
        android:id="@+id/calibrationBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_calibration_badge"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Row 1: Compact profile info + prominent Lock button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCalibrationInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCalibrationDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_calibration_done"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="完成鎖定"
                android:textColor="#041E49"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Scale -, Scale +, Center, Reset neatly inset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnScaleMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_calibration_done"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="縮小 －"
                android:textColor="#041E49"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScalePlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_calibration_done"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="放大 ＋"
                android:textColor="#041E49"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCalibrationCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_calibration_done"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="置中"
                android:textColor="#041E49"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCalibrationReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_calibration_done"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="重設"
                android:textColor="#041E49"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pillRowContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/handleResizeLeft"
            android:layout_width="16dp"
            android:layout_height="34dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_calibration_badge"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="320dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/ivGoogleLogo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Google"
                android:src="@drawable/ic_google_g" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="語音搜尋"
                android:padding="6dp"
                android:src="@drawable/ic_google_mic" />

            <ImageView
                android:id="@+id/btnLens"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Google Lens"
                android:padding="6dp"
                android:src="@drawable/ic_google_lens" />
        </LinearLayout>

        <TextView
            android:id="@+id/handleResizeRight"
            android:layout_width="16dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_calibration_badge"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
